{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/test/jest-e2e.setup.ts"],
  "moduleNameMapper": {
    "^\\.\\./generated/prisma/client$": "<rootDir>/src/generated/prisma-test/client",
    "^src/generated/prisma/client$": "<rootDir>/src/generated/prisma-test/client"
  }
}
